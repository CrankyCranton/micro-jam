code = "shader_type canvas_item;
render_mode blend_mix;

uniform float Wind_Strength : hint_range(-5.0, -5.0);



void vertex() {
// Input:2
	vec2 n_out2p0 = VERTEX;


// VectorDecompose:3
	float n_out3p0 = n_out2p0.x;
	float n_out3p1 = n_out2p0.y;


// FloatParameter:4
	float n_out4p0 = Wind_Strength;


// Input:7
	vec2 n_out7p0 = UV;


// VectorDecompose:8
	float n_out8p0 = n_out7p0.x;
	float n_out8p1 = n_out7p0.y;


// FloatFunc:11
	float n_out11p0 = 1.0 - n_out8p1;


// FloatOp:10
	float n_out10p0 = n_out4p0 * n_out11p0;


// Input:15
	vec2 n_out15p0 = VERTEX;


// VectorDecompose:16
	float n_out16p0 = n_out15p0.x;
	float n_out16p1 = n_out15p0.y;


// Input:12
	float n_out12p0 = TIME;


// FloatOp:17
	float n_out17p0 = n_out16p0 + n_out12p0;


// FloatFunc:13
	float n_out13p0 = sin(n_out17p0);


// FloatOp:14
	float n_out14p0 = n_out10p0 * n_out13p0;


// FloatOp:5
	float n_out5p0 = n_out3p0 + n_out14p0;


// VectorCompose:6
	vec2 n_out6p0 = vec2(n_out5p0, n_out3p1);


// Output:0
	VERTEX = n_out6p0;


}
